<Window x:Class="_2026_1AI_2_TVRDY_PRETEKY.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_2026_1AI_2_TVRDY_PRETEKY"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Rýchlosť" HorizontalAlignment="Left" Margin="22,25,0,0" VerticalAlignment="Top" Width="58"/>
        <TextBox x:Name="txtRychlost" HorizontalAlignment="Left" Margin="85,25,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="26"/>
        <Label Content="Nádrž" HorizontalAlignment="Left" Margin="22,62,0,0" VerticalAlignment="Top" Width="58"/>
        <Label Content="Spotreba" HorizontalAlignment="Left" Margin="22,96,0,0" VerticalAlignment="Top" Width="58"/>
        <TextBox x:Name="txtNadrz" HorizontalAlignment="Left" Margin="85,62,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="26"/>
        <TextBox x:Name="txtSpotreba" HorizontalAlignment="Left" Margin="85,101,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Height="26"/>
        <Button x:Name="btnPridaj" Content="Pridaj Auto" HorizontalAlignment="Left" Margin="70,142,0,0" VerticalAlignment="Top" Height="29" Width="135" Click="btnPridaj_Click"/>
        <Button Content="Vypíš Autá" HorizontalAlignment="Left" Margin="70,185,0,0" VerticalAlignment="Top" Width="135" Height="32" Click="Button_Click"/>
        <Button Content="Vymaž Auta" HorizontalAlignment="Left" Margin="70,228,0,0" VerticalAlignment="Top" Width="135" Height="31" Click="Button_Click_1"/>
        <Label Content="Počet kôl" HorizontalAlignment="Left" Margin="10,282,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtPocKol" HorizontalAlignment="Left" Margin="85,282,0,0" TextWrapping="Wrap" Text="3" VerticalAlignment="Top" Width="120"/>
        <Label Content="Dĺžka trate" HorizontalAlignment="Left" Margin="6,313,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="txtDlzkaTrate" HorizontalAlignment="Left" Margin="85,317,0,0" TextWrapping="Wrap" Text="15" VerticalAlignment="Top" Width="120"/>
        <Button x:Name="btnPretekaj" Content="Pretekaj" HorizontalAlignment="Left" Margin="16,355,0,0" VerticalAlignment="Top" Height="59" Width="189" Click="btnPretekaj_Click"/>
        <TextBlock x:Name="txtVypis" HorizontalAlignment="Left" Margin="252,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Height="375" Width="527"/>

    </Grid>
</Window>
